# Faust Real-time MCP Server Configuration

# Path to the node-web-audio-api checkout (default: external/node-web-audio-api)
WEBAUDIO_ROOT=external/node-web-audio-api

# Port for the optional Faust UI server (set to 0 to disable)
FAUST_UI_PORT=8787

# Path to a built faust-ui bundle (optional)
# FAUST_UI_ROOT=

# Path to a default DSP file to load on startup (optional)
# FAUST_DEFAULT_DSP=noise.dsp

# MCP Server Configuration

MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_TRANSPORT=sse
